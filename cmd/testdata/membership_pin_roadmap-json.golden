          ]
        },
        {
          "epic": {
            "id": "tnib-e005",
            "slug": "real-time-collaboration",
            "path": "data/tnib-e005--real-time-collaboration.md",
            "version": 1,
            "title": "Real-time Collaboration",
            "status": "draft",
            "type": "epic",
            "priority": "normal",
            "estimate": "xl",
            "created_at": "2026-03-10T10:00:00Z",
            "updated_at": "2026-03-18T09:00:00Z",
            "body": "\n## Objective\n\nEnable live multi-user editing with WebSocket-based updates and conflict resolution.\n\n## Acceptance Criteria\n\n- [ ] WebSocket server with connection management\n- [ ] Optimistic UI updates with server reconciliation\n- [ ] Activity feed powered by event sourcing\n\n## Scope Boundaries\n\n- Operational transform / CRDT for rich text editing deferred\n- Voice/video collaboration out of scope",
            "parent": "tnib-m002",
            "documents": [
              "docs/websocket-rfc.md"
            ],
            "order": "a",
            "etag": "738d2168bc044e1e"
          },
          "progress": {
            "total": 2,
            "done": 0,
            "percent": 0,
            "scrapped": 0,
            "deferred": 0
          },
          "items": [
            {
              "id": "tnib-f014",
              "slug": "websocket-live-updates",
              "path": "data/tnib-f014--websocket-live-updates.md",
              "version": 1,
              "title": "WebSocket live updates",
              "status": "draft",
              "type": "feature",
              "priority": "normal",
              "estimate": "xl",
              "created_at": "2026-03-12T09:00:00Z",
              "updated_at": "2026-03-18T09:00:00Z",
              "body": "\nReal-time task board updates via WebSocket connections with optimistic UI and server reconciliation.\n\n## Acceptance Criteria\n\n- [ ] WebSocket server with connection lifecycle management\n- [ ] Client-side optimistic updates with rollback on conflict\n- [ ] Presence indicators (who's viewing what)\n- [ ] Graceful reconnection with state sync",
              "parent": "tnib-e005",
              "documents": [
                "docs/websocket-rfc.md"
              ],
              "order": "a",
              "etag": "a9c826f370fce81c"
            },
            {
              "id": "tnib-f015",
